    {"@type": "cr:RecordSet", "@id": "instances", "name": "instances", "description": "the instance table (instances.csv)", "key": {"@id": "instances/instance"}, "field": [{"@type": "cr:Field", "@id": "instances/instance", "name": "instance", "description": "instance id: <region>-t<technicians>-<kind>-s<seed>", "dataType": "sc:Text", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "instance"}}}, {"@type": "cr:Field", "@id": "instances/region", "name": "region", "description": "city the day is set in", "dataType": "sc:Text", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "region"}}}, {"@type": "cr:Field", "@id": "instances/kind", "name": "kind", "description": "full (queue far beyond capacity) or servable (one known plan serves every job)", "dataType": "sc:Text", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "kind"}}}, {"@type": "cr:Field", "@id": "instances/technicians", "name": "technicians", "description": "technicians", "dataType": "sc:Integer", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "technicians"}}}, {"@type": "cr:Field", "@id": "instances/teams", "name": "teams", "description": "teams (routes)", "dataType": "sc:Integer", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "teams"}}}, {"@type": "cr:Field", "@id": "instances/jobs", "name": "jobs", "description": "jobs in the queue", "dataType": "sc:Integer", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "jobs"}}}, {"@type": "cr:Field", "@id": "instances/locations", "name": "locations", "description": "matrix size n", "dataType": "sc:Integer", "source": {"fileObject": {"@id": "instances.csv"}, "extract": {"column": "locations"}}}, {"@type": "cr:Field", "@id": "instances/queue_service_minutes", "name": "queue_service_minutes", "description": "service minutes of all jobs", "dataType": "sc:Integer", "source": {"fileObject": {"@id": "instances.csv"}, "extract":