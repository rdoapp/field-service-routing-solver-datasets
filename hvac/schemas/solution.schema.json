{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solution.schema.json",
  "title": "HVAC field-service planning solution",
  "description": "A solution of one problem: per team the jobs it serves, in order, with each service's start (minutes after local midnight). FORMAT.md describes every field. For checking a solution of your own only format, format_version, instance and routes are needed; the release's solutions carry all fields.",
  "type": "object",
  "required": ["format", "format_version", "instance", "routes"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "hvac-field-service-solution"},
    "format_version": {"const": "1.0"},
    "instance": {"type": "string", "pattern": "^[a-z]+-t[0-9]{2}-[a-z]+-s[0-9]+$"},
    "solution": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "routes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["team", "stops"],
        "properties": {
          "team": {"type": "string"},
          "stops": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["job", "start"],
              "properties": {"job": {"type": "string"}, "start": {"type": "integer"}}
            }
          }
        }
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["service_minutes", "priority3_service_minutes", "travel_time_s", "travel_distance_m",
                   "jobs_served"],
      "properties": {
        "service_minutes": {"type": "integer", "minimum": 0},
        "priority3_service_minutes": {"type": "integer", "minimum": 0},
        "travel_time_s": {"type": "integer", "minimum": 0},
        "travel_distance_m": {"type": "integer", "minimum": 0},
        "jobs_served": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["solver", "iteration_budget", "random_seed", "fixed_clock", "date", "wall_time_s",
                   "invocation_sha256", "note"],
      "properties": {
        "solver": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "commit"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "commit": {"type": ["string", "null"]}}
        },
        "iteration_budget": {"type": ["integer", "null"], "minimum": 1},
        "random_seed": {"type": ["integer", "null"]},
        "fixed_clock": {"type": ["string", "null"]},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "wall_time_s": {"type": ["number", "null"], "minimum": 0},
        "invocation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
