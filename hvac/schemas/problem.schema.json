{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem.schema.json",
  "title": "HVAC field-service planning problem",
  "description": "One planning day: locations, technicians, teams, jobs and the objective. FORMAT.md describes every field; PROBLEM.md defines the problem. Times are whole minutes after local midnight of the date.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "dataset_major_version", "instance", "description", "region", "kind",
               "date", "timezone", "time_unit", "matrices", "locations", "technicians", "teams", "jobs",
               "objective", "bounds", "provenance"],
  "properties": {
    "format": {"const": "hvac-field-service-problem"},
    "format_version": {"const": "1.0"},
    "dataset_major_version": {"type": "integer", "minimum": 1},
    "instance": {"$ref": "#/$defs/instanceId"},
    "description": {"type": "string"},
    "region": {
      "type": "object", "additionalProperties": false, "required": ["name", "country"],
      "properties": {"name": {"type": "string"}, "country": {"type": "string", "pattern": "^[A-Z]{2}$"}}
    },
    "kind": {"enum": ["full", "servable"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"type": "string"},
    "time_unit": {"const": "minutes after local midnight of date"},
    "matrices": {
      "type": "object", "additionalProperties": false, "required": ["n", "durations", "distances", "sha256"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "durations": {"const": "durations_s.csv.gz"},
        "distances": {"const": "distances_m.csv.gz"},
        "sha256": {
          "type": "object", "additionalProperties": false, "required": ["durations", "distances"],
          "properties": {"durations": {"$ref": "#/$defs/sha256"}, "distances": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "locations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["index", "lat", "lon"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180}
        }
      }
    },
    "technicians": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "start_location", "end_location", "shift", "breaks", "skills",
                     "max_route_duration_min", "max_route_distance_m"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "start_location": {"type": "integer", "minimum": 0},
          "end_location": {"type": "integer", "minimum": 0},
          "shift": {"$ref": "#/$defs/interval"},
          "breaks": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
          "skills": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "max_route_duration_min": {"type": ["integer", "null"], "minimum": 0},
          "max_route_distance_m": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "teams": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "members"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "location", "service_minutes", "windows", "priority", "value_eur", "skills",
                     "attributes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "location": {"type": "integer", "minimum": 0},
          "service_minutes": {"type": "integer", "minimum": 1},
          "windows": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
          "priority": {"enum": [1, 2, 3]},
          "value_eur": {"type": "integer", "minimum": 0,
                        "description": "descriptive only: in no constraint or objective of this format"},
          "skills": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["skill", "count"],
              "properties": {"skill": {"$ref": "#/$defs/id"}, "count": {"type": "integer", "minimum": 1}}
            }
          },
          "attributes": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "customer_type", "dwelling", "devices"],
            "properties": {
              "type": {"enum": ["cleaning", "washing", "installation", "repair"]},
              "customer_type": {"enum": ["working", "home", "business"]},
              "dwelling": {"enum": ["flat", "house", "office"]},
              "devices": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["tiers"],
      "properties": {
        "tiers": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"const": {"rank": 1, "name": "service_minutes", "sense": "maximize", "unit": "min"}},
            {"const": {"rank": 2, "name": "priority3_service_minutes", "sense": "maximize", "unit": "min"}},
            {"const": {"rank": 3, "name": "travel_time_s", "sense": "minimize", "unit": "s"}}
          ]
        }
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["service_minutes_max", "priority3_service_minutes_max", "statement"],
      "properties": {
        "service_minutes_max": {"type": "integer", "minimum": 0},
        "priority3_service_minutes_max": {"type": "integer", "minimum": 0},
        "statement": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "instance_spec", "parameters", "population", "routing"],
      "properties": {
        "generator": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "commit", "repository"],
          "properties": {
            "name": {"type": "string"}, "version": {"type": "string"},
            "commit": {"type": "string"}, "repository": {"type": ["string", "null"]}
          }
        },
        "instance_spec": {
          "type": "object", "additionalProperties": false,
          "required": ["region", "technicians", "kind", "seed", "date", "features"],
          "properties": {
            "region": {"type": "string"}, "technicians": {"type": "integer", "minimum": 1},
            "kind": {"enum": ["full", "servable"]}, "seed": {"type": "integer"},
            "date": {"type": "string"}, "features": {"type": "array", "items": {"type": "string"}}
          }
        },
        "parameters": {"type": "object"},
        "population": {
          "type": "object", "additionalProperties": false, "required": ["name", "url", "sha256", "use"],
          "properties": {
            "name": {"type": "string"}, "url": {"type": "string"},
            "sha256": {"$ref": "#/$defs/sha256"}, "use": {"type": "string"}
          }
        },
        "routing": {"type": "object", "required": ["engine"], "properties": {"engine": {"type": "string"}}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "instanceId": {"type": "string", "pattern": "^[a-z]+-t[0-9]{2}-[a-z]+-s[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false
    }
  }
}
